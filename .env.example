# =============================================================================
# .env.example — secrets template. Copy to `.env` (gitignored) and fill in real values.
# NEVER commit `.env`. Every value below is a placeholder.
#
# Two groups of variables live here:
#   1. GRAPHRAG_SECRETS__* — read by graphrag/config/settings.py into Settings.secrets
#      (SecretStr fields). This is the app's ONLY view of credentials.
#   2. Infra creds for docker-compose service containers themselves (Postgres, Neo4j,
#      the LiteLLM proxy, and — ONLY on the litellm container — provider API keys).
#      The api/worker containers must NEVER receive GEMINI_API_KEY / GROQ_API_KEY /
#      OPENROUTER_API_KEY — the LiteLLM gateway is the sole holder of provider keys.
# =============================================================================

# Which config/{APP_ENV}.yaml overlay loads on top of base.yaml.
APP_ENV=local

# -----------------------------------------------------------------------------
# App secrets (Settings.secrets — GRAPHRAG_ prefix, __ nested delimiter)
# -----------------------------------------------------------------------------
GRAPHRAG_SECRETS__POSTGRES_DSN=postgresql://graphrag:changeme@postgres:5432/graphrag
GRAPHRAG_SECRETS__LITELLM_MASTER_KEY=sk-litellm-master-changeme
GRAPHRAG_SECRETS__LITELLM_VIRTUAL_KEY=sk-litellm-virtual-changeme
GRAPHRAG_SECRETS__NEO4J_PASSWORD=changeme
GRAPHRAG_SECRETS__ADMIN_API_KEY=changeme-admin-key

# -----------------------------------------------------------------------------
# Postgres container
# -----------------------------------------------------------------------------
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=changeme
POSTGRES_DB=graphrag
POSTGRES_DSN=postgresql://graphrag:changeme@postgres:5432/graphrag

# -----------------------------------------------------------------------------
# Neo4j container
# -----------------------------------------------------------------------------
NEO4J_AUTH=neo4j/changeme

# -----------------------------------------------------------------------------
# LiteLLM proxy container ONLY — provider keys never reach api/worker.
# -----------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-litellm-master-changeme
LITELLM_VIRTUAL_KEY=sk-litellm-virtual-changeme
GEMINI_API_KEY=changeme
GROQ_API_KEY=changeme
GROQ_API_KEY_2=changeme
OPENROUTER_API_KEY=changeme
